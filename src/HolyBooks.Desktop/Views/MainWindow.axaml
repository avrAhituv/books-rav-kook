<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HolyBooks.Desktop.ViewModels"
        xmlns:views="using:HolyBooks.Desktop.Views"
        x:Class="HolyBooks.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="ספריית הקודש"
        Width="1400" Height="900"
        MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+F" Command="{Binding ToggleSearchPanelCommand}" />
        <KeyBinding Gesture="Ctrl+T" Command="{Binding OpenInNewTabCommand}" />
        <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseTabCommand}" CommandParameter="{Binding SelectedTab}" />
        <KeyBinding Gesture="Ctrl+OemPlus" Command="{Binding IncreaseFontSizeCommand}" />
        <KeyBinding Gesture="Ctrl+OemMinus" Command="{Binding DecreaseFontSizeCommand}" />
    </Window.KeyBindings>

    <DockPanel>
        <!-- Top Menu Bar -->
        <Border DockPanel.Dock="Top" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="8,4">
                <!-- Left: Menu -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                    <Button Content="☰" Command="{Binding ToggleSidePanelCommand}"
                            ToolTip.Tip="הצג/הסתר עץ ספרים"
                            Background="Transparent" Padding="8" />

                    <Button Content="📥 ייבוא" Command="{Binding ImportBooksCommand}"
                            Background="Transparent" Padding="8,4" />
                </StackPanel>

                <!-- Center: Title -->
                <TextBlock Grid.Column="1" Text="ספריית הקודש"
                           FontSize="18" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontFamily="{StaticResource HebrewFont}" />

                <!-- Right: Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                    <Button Content="🔍" Command="{Binding ToggleSearchPanelCommand}"
                            ToolTip.Tip="חיפוש (Ctrl+F)"
                            Background="Transparent" Padding="8" />

                    <Button Content="A+" Command="{Binding IncreaseFontSizeCommand}"
                            ToolTip.Tip="הגדל גופן"
                            Background="Transparent" Padding="8" />

                    <Button Content="A-" Command="{Binding DecreaseFontSizeCommand}"
                            ToolTip.Tip="הקטן גופן"
                            Background="Transparent" Padding="8" />

                    <ComboBox SelectedItem="{Binding CurrentTheme}" Width="80" Margin="8,0">
                        <ComboBoxItem Content="בהיר" Tag="light" />
                        <ComboBoxItem Content="כהה" Tag="dark" />
                        <ComboBoxItem Content="ספיה" Tag="sepia" />
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid ColumnDefinitions="Auto,*,Auto">

            <!-- Left Sidebar: Book Tree -->
            <Border Grid.Column="0" Classes="sidebar"
                    IsVisible="{Binding IsSidePanelOpen}">
                <DockPanel>
                    <!-- Tree Header -->
                    <Border DockPanel.Dock="Top" Padding="12,8" Background="#EEEEEE">
                        <TextBlock Text="ספרים" FontWeight="SemiBold"
                                   FontFamily="{StaticResource HebrewFont}" />
                    </Border>

                    <!-- Filter -->
                    <TextBox DockPanel.Dock="Top"
                             Text="{Binding BookTree.FilterText}"
                             Watermark="🔍 חפש ספר..."
                             Classes="hebrew"
                             Margin="8" />

                    <!-- Tree View -->
                    <TreeView ItemsSource="{Binding BookTree.RootNodes}"
                              SelectedItem="{Binding BookTree.SelectedNode}">
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding Icon}" />
                                    <TextBlock Text="{Binding Title}"
                                               FontFamily="{StaticResource HebrewFont}" />
                                </StackPanel>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>

            <!-- Main: Reader with Tabs -->
            <DockPanel Grid.Column="1">
                <!-- Tab Strip -->
                <TabControl DockPanel.Dock="Top"
                            ItemsSource="{Binding OpenTabs}"
                            SelectedItem="{Binding SelectedTab}">
                    <TabControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TabItemViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Title}"
                                           FontFamily="{StaticResource HebrewFont}"
                                           MaxWidth="150" TextTrimming="CharacterEllipsis" />
                                <Button Content="✕" FontSize="10"
                                        Background="Transparent" Padding="4,2"
                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CloseTabCommand}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                    <TabControl.ContentTemplate>
                        <DataTemplate x:DataType="vm:TabItemViewModel">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto"
                                          Padding="24">
                                <StackPanel MaxWidth="800" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Title}"
                                               Classes="heading" />
                                    <TextBlock Text="{Binding Content}"
                                               Classes="reader"
                                               FontSize="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).FontSize}" />
                                </StackPanel>
                            </ScrollViewer>
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>

                <!-- Empty State -->
                <Border IsVisible="{Binding !OpenTabs.Count}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
                        <TextBlock Text="📚" FontSize="64" HorizontalAlignment="Center" />
                        <TextBlock Text="בחר ספר מהרשימה כדי להתחיל לקרוא"
                                   FontSize="18" Opacity="0.6"
                                   FontFamily="{StaticResource HebrewFont}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </DockPanel>

            <!-- Right Panel: Search (Overlay) -->
            <Border Grid.Column="2" Width="400"
                    Background="White"
                    BorderBrush="#E0E0E0" BorderThickness="1,0,0,0"
                    IsVisible="{Binding IsSearchPanelOpen}">
                <DockPanel>
                    <!-- Search Header -->
                    <Border DockPanel.Dock="Top" Padding="12" Background="#F5F5F5">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="חיפוש" FontWeight="SemiBold"
                                       FontFamily="{StaticResource HebrewFont}" />
                            <Button Grid.Column="1" Content="✕"
                                    Background="Transparent"
                                    Command="{Binding ToggleSearchPanelCommand}" />
                        </Grid>
                    </Border>

                    <!-- Search Input -->
                    <StackPanel DockPanel.Dock="Top" Margin="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Text="{Binding Search.SearchQuery}"
                                     Watermark="הקלד לחיפוש..."
                                     Classes="hebrew" />
                            <Button Grid.Column="1" Content="🔍"
                                    Command="{Binding Search.SearchCommand}"
                                    Margin="8,0,0,0" />
                        </Grid>

                        <!-- Filters -->
                        <WrapPanel Margin="0,8,0,0">
                            <CheckBox Content="רב קוק" IsChecked="{Binding Search.SearchInRavKook}" Margin="0,0,12,0" />
                            <CheckBox Content="תנ״ך" IsChecked="{Binding Search.SearchInTanakh}" Margin="0,0,12,0" />
                            <CheckBox Content="תלמוד" IsChecked="{Binding Search.SearchInTalmud}" />
                        </WrapPanel>

                        <!-- Results Info -->
                        <TextBlock Margin="0,8,0,0" FontSize="12" Opacity="0.7"
                                   FontFamily="{StaticResource HebrewFont}"
                                   IsVisible="{Binding Search.ResultCount}">
                            <Run Text="נמצאו" />
                            <Run Text="{Binding Search.ResultCount}" />
                            <Run Text="תוצאות" />
                            <Run Text="(" /><Run Text="{Binding Search.SearchTime, StringFormat={}{0:F2}}" /><Run Text=" שניות)" />
                        </TextBlock>
                    </StackPanel>

                    <!-- Results List -->
                    <ListBox ItemsSource="{Binding Search.Results}"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="search-result" Padding="8">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding FullReference}"
                                                   FontWeight="SemiBold" FontSize="13"
                                                   FontFamily="{StaticResource HebrewFont}"
                                                   Foreground="#1976D2" />
                                        <TextBlock Text="{Binding Snippet}"
                                                   TextWrapping="Wrap"
                                                   FontSize="14" Opacity="0.8"
                                                   FontFamily="{StaticResource HebrewFont}"
                                                   MaxLines="3" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
