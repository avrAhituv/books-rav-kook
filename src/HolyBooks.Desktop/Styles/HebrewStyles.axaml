<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="using:HolyBooks.Desktop.Converters">

    <!-- משאבים - גופנים, צבעים וממירים -->
    <Styles.Resources>
        <ResourceDictionary>
            <!-- צבעים -->
            <Color x:Key="PrimaryColor">#1976D2</Color>
            <Color x:Key="SecondaryColor">#424242</Color>
            <Color x:Key="AccentColor">#FFC107</Color>
            <Color x:Key="BackgroundColor">#FAFAFA</Color>
            <Color x:Key="SurfaceColor">#FFFFFF</Color>
            <Color x:Key="TextPrimaryColor">#212121</Color>
            <Color x:Key="TextSecondaryColor">#757575</Color>

            <!-- גופנים -->
            <FontFamily x:Key="HebrewFont">David, Noto Serif Hebrew, Segoe UI</FontFamily>
            <FontFamily x:Key="HebrewFontSerif">Frank Ruhl Libre, David, Segoe UI</FontFamily>

            <!-- מידות -->
            <x:Double x:Key="DefaultFontSize">18</x:Double>
            <x:Double x:Key="HeadingFontSize">24</x:Double>
            <x:Double x:Key="SmallFontSize">14</x:Double>
            <Thickness x:Key="DefaultMargin">8</Thickness>
            <Thickness x:Key="DefaultPadding">12</Thickness>

            <!-- ממירים -->
            <conv:EqualConverter x:Key="EqualConverter" />
            <conv:NotEqualConverter x:Key="NotEqualConverter" />
            <conv:DirtyTextConverter x:Key="DirtyTextConverter" />
            <conv:ContainsConverter x:Key="ContainsConverter" />
            <conv:HtmlToPlainTextConverter x:Key="HtmlToPlainTextConverter" />
            <conv:NumberToHebrewConverter x:Key="NumberToHebrewConverter" />
            <conv:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <conv:BooleanToOpacityConverter x:Key="BooleanToOpacityConverter" />
            <conv:ThemeToColorConverter x:Key="ThemeToColorConverter" />
            <conv:TruncateConverter x:Key="TruncateConverter" />
            <conv:HebrewDateConverter x:Key="HebrewDateConverter" />
            <conv:RelativeTimeConverter x:Key="RelativeTimeConverter" />
        </ResourceDictionary>
    </Styles.Resources>

    <!-- כיוון RTL לכל האפליקציה -->
    <Style Selector="Window">
        <Setter Property="FlowDirection" Value="RightToLeft" />
    </Style>

    <!-- סגנון טקסט עברי -->
    <Style Selector="TextBlock.hebrew">
        <Setter Property="FontFamily" Value="{StaticResource HebrewFont}" />
        <Setter Property="FontSize" Value="{StaticResource DefaultFontSize}" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="FlowDirection" Value="RightToLeft" />
    </Style>

    <!-- סגנון לקריאה -->
    <Style Selector="TextBlock.reader">
        <Setter Property="FontFamily" Value="{StaticResource HebrewFontSerif}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="LineHeight" Value="36" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="FlowDirection" Value="RightToLeft" />
        <Setter Property="Margin" Value="0,8" />
    </Style>

    <!-- כותרת -->
    <Style Selector="TextBlock.heading">
        <Setter Property="FontFamily" Value="{StaticResource HebrewFont}" />
        <Setter Property="FontSize" Value="{StaticResource HeadingFontSize}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,16,0,8" />
    </Style>

    <!-- כותרת משנית -->
    <Style Selector="TextBlock.subheading">
        <Setter Property="FontFamily" Value="{StaticResource HebrewFont}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="Margin" Value="0,12,0,4" />
    </Style>

    <!-- TreeView בעברית -->
    <Style Selector="TreeViewItem">
        <Setter Property="FlowDirection" Value="RightToLeft" />
        <Setter Property="FontFamily" Value="{StaticResource HebrewFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="4" />
    </Style>

    <!-- TabControl בעברית -->
    <Style Selector="TabItem">
        <Setter Property="FlowDirection" Value="RightToLeft" />
        <Setter Property="FontFamily" Value="{StaticResource HebrewFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <!-- כפתור -->
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{StaticResource PrimaryColor}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontFamily" Value="{StaticResource HebrewFont}" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <!-- TextBox בעברית -->
    <Style Selector="TextBox.hebrew">
        <Setter Property="FlowDirection" Value="RightToLeft" />
        <Setter Property="FontFamily" Value="{StaticResource HebrewFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Padding" Value="8" />
    </Style>

    <!-- ListBox -->
    <Style Selector="ListBoxItem">
        <Setter Property="FlowDirection" Value="RightToLeft" />
        <Setter Property="FontFamily" Value="{StaticResource HebrewFont}" />
        <Setter Property="Padding" Value="8,4" />
    </Style>

    <!-- Sidebar Panel -->
    <Style Selector="Border.sidebar">
        <Setter Property="Background" Value="#F5F5F5" />
        <Setter Property="BorderBrush" Value="#E0E0E0" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="Width" Value="280" />
    </Style>

    <!-- Card Style -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="#E0E0E0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="8" />
        <Setter Property="BoxShadow" Value="0 2 4 0 #20000000" />
    </Style>

    <!-- Search Result Item -->
    <Style Selector="Border.search-result">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="#E0E0E0" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <Style Selector="Border.search-result:pointerover">
        <Setter Property="Background" Value="#F5F5F5" />
    </Style>

    <!-- Book/Tractate Button -->
    <Style Selector="Button.book-button">
        <Setter Property="Background" Value="#E3F2FD" />
        <Setter Property="Foreground" Value="#1565C0" />
        <Setter Property="FontFamily" Value="{StaticResource HebrewFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.book-button:pointerover">
        <Setter Property="Background" Value="#BBDEFB" />
    </Style>

    <Style Selector="Button.book-button:pressed">
        <Setter Property="Background" Value="#90CAF9" />
    </Style>

    <!-- Commentary Tag -->
    <Style Selector="ToggleButton.commentary-tag">
        <Setter Property="Background" Value="#F5F5F5" />
        <Setter Property="Foreground" Value="#616161" />
        <Setter Property="FontFamily" Value="{StaticResource HebrewFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#E0E0E0" />
    </Style>

    <Style Selector="ToggleButton.commentary-tag:checked">
        <Setter Property="Background" Value="#1976D2" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="#1976D2" />
    </Style>

    <!-- Verse Number -->
    <Style Selector="TextBlock.verse-number">
        <Setter Property="FontFamily" Value="{StaticResource HebrewFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="#1976D2" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="0,4,8,0" />
    </Style>

    <!-- Talmud Text Styles -->
    <Style Selector="TextBlock.gemara-text">
        <Setter Property="FontFamily" Value="{StaticResource HebrewFontSerif}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="LineHeight" Value="32" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextAlignment" Value="Right" />
    </Style>

    <Style Selector="TextBlock.rashi-text">
        <Setter Property="FontFamily" Value="Rashi, David, Serif" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="24" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextAlignment" Value="Right" />
    </Style>

    <Style Selector="TextBlock.tosafot-text">
        <Setter Property="FontFamily" Value="Rashi, David, Serif" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="24" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextAlignment" Value="Right" />
    </Style>

    <!-- Daf Navigation -->
    <Style Selector="Button.daf-nav">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="{StaticResource HebrewFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.daf-nav:pointerover">
        <Setter Property="Background" Value="#F5F5F5" />
    </Style>

</Styles>
